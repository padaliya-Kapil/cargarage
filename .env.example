# Copy to .env (or set in your host's dashboard)
PORT=3000
# Where the SQLite database lives (keep this on a persistent disk)
DATA_DIR=./data
# First-run owner account. If not set, a random password is printed to the console once.
ADMIN_EMAIL=owner@chobbargarage.com
ADMIN_PASSWORD=change-me-please
# Set to 1 when serving behind HTTPS (adds Secure flag to the session cookie)
COOKIE_SECURE=0
# Optional: POST new bookings/enquiries as JSON to this URL (Zapier/Make/n8n -> SMS, email, WhatsApp)
NOTIFY_WEBHOOK_URL=
